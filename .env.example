# Telegram Bot Tokeningizni @BotFather orqali oling va bu yerga yozing:
BOT_TOKEN=7123456789:AAExampleBotTokenHere

# Google Gemini API kalitini https://aistudio.google.com/app/apikey dan oling:
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.8-flash

# Qo'riqchi (Access Control / Whitelist) sozlamalari:
# Asosiy admin Telegram ID raqamlari (vergul bilan ajratilgan holda):
ADMIN_IDS=123456789,987654321

# Botda /admin_login buyrug'i orqali adminlikni tasdiqlash paroli:
ADMIN_PASSWORD=BU_YERGA_KUCHLI_PAROL_YOZING
